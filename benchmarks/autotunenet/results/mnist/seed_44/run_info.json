{
  "task": "mnist",
  "seed": 44,
  "device": "mps",
  "torch_version": "2.15.0",
  "batch_size": 64,
  "method": "autotunenet",
  "initial_lr": 0.01,
  "autotunenet": {
    "parameter_space": {
      "lr": {
        "low": 0.0001,
        "high": 0.1,
        "log": true
      }
    },
    "search": {
      "n_startup_trials": 3
    },
    "tuning": {
      "tune_n_steps": 1,
      "warmup_epochs": 2,
      "max_delta": 0.5
    },
    "metrics": {
      "smoothing_window": 3
    },
    "stability": {
      "max_regression": 0.2,
      "patience": 2,
      "cooldown": 3
    }
  }
}